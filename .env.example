# GEMINI_API_KEY: Required for Gemini AI API calls (if applicable)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted
APP_URL="MY_APP_URL"

# MONGODB_URI: MongoDB Atlas connection string
# Format: mongodb+srv://<username>:<password>@<cluster-url>/smartcampus?retryWrites=true&w=majority
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/smartcampus?retryWrites=true&w=majority"

# SESSION_SECRET: Secret used to sign session cookies
SESSION_SECRET="smartcampus-college-viva-session-secret-2025"

# PORT: Server port (default 3000)
PORT=3000
